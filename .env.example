# Database
DATABASE_URL="postgresql://rabbit:rabbit@localhost:5434/rabbit?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# API (Express + Socket.io — default port 4000 to avoid clashing with Next.js on 3000)
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:4000"
SOCKET_BROADCAST_URL="http://localhost:4000"

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS (comma-separated origins for mobile/web apps)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
