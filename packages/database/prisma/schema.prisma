// Rabbit — hyperlocal delivery schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  VENDOR
  RABBITOR
  ADMIN
}

enum StoreType {
  KIRANA
  FISH
  VEGETABLE
  PHARMACY
  BAKERY
  DAIRY
  MEAT
  GENERAL
}

/// PLATFORM CORE RESOLUTION — admin-uploaded global master catalog items
model MasterCatalogItem {
  id           String    @id @default(uuid())
  storeType    StoreType @default(GENERAL)
  name         String
  description  String?
  category     String    @default("general")
  defaultUnit  String    @default("piece")
  basePrice    Float
  imageUrl     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeType, isActive])
  @@index([category])
}

enum DeliveryMethod {
  SELF
  RABBITOR
  THIRD_PARTY
}

enum OrderStatus {
  PENDING
  ACCEPTED_BY_SHOP
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentIntentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum SubscriptionTier {
  FREE
  SILVER
  GOLD
  PLATINUM
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocType {
  AADHAAR
  GST
  PAN
  SHOP_PHOTO
}

enum DiscountType {
  FLAT
  PERCENT
}

enum Locale {
  en
  hi
  mr
  ta
  te
  bn
}

enum AdPlacement {
  HOME_BANNER
  HOME_STRIP
  SHOP_PAGE
  CART_PAGE
  CHECKOUT_PAGE
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

model User {
  id            String    @id @default(uuid())
  name          String
  phone         String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  googleId      String?   @unique
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  displayName   String?
  /// GOOGLE MAPS & AUTH ACTIVATION — Google profile photo URL
  avatarUrl     String?
  locale        Locale    @default(en)
  fcmToken      String?
  /// LIVE ECOSYSTEM UPGRADE — last known delivery / profile coordinates
  lastLatitude  Float?
  lastLongitude Float?
  savedAddress  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendorProfile   VendorProfile?
  rabbitorProfile RabbitorProfile?
  shops           Shop[]
  orders          Order[] @relation("CustomerOrders")
  deliveries      Order[] @relation("DeliveryPartnerOrders")
  addresses       CustomerAddress[]
  paymentIntents  PaymentIntent[]

  @@index([role])
  @@index([phone])
}

/// Saved delivery addresses — Swiggy/Zomato-style multi-address book
model CustomerAddress {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       AddressLabel @default(HOME)
  customLabel String?
  line1       String
  line2       String?
  landmark    String?
  area        String?
  city        String       @default("Mumbai")
  pincode     String?
  latitude    Float
  longitude   Float
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

/// Vendor business data — KYC fields never exposed on customer UI
model VendorProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  /// MERCHANT DASHBOARD EXPANSION — operational category label (Cloud Kitchen, Groceries, etc.)
  businessCategory String?
  supportPhone     String?
  kycStatus        KycStatus        @default(PENDING)
  subscriptionTier SubscriptionTier @default(FREE)
  /// Encrypted at rest in production; never returned to customers
  aadhaarRef       String?
  gstRef           String?
  panRef           String?
  fssaiRef         String?
  bankAccountRef   String?
  ifscCode         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  shops Shop[]
  kycDocuments KycDocument[]
}

model KycDocument {
  id              String        @id @default(uuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  docType         KycDocType
  fileUrl         String
  status          KycStatus     @default(PENDING)
  reviewNote      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([vendorProfileId, status])
}

model RabbitorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isVerified  Boolean  @default(false)
  isAvailable Boolean  @default(false)
  currentLat  Float?
  currentLng  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shop {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id])
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category String
  storeType StoreType @default(GENERAL)
  image    String?
  isActive Boolean @default(true)

  address          String
  /// Full address — revealed to delivery only after order confirmed delivered
  addressEncrypted String?
  latitude         Float
  longitude        Float

  deliveryRadiusKm  Float          @default(5)
  minOrderValue     Float          @default(0)
  baseDeliveryFee   Float          @default(20)
  avgPrepMinutes    Int            @default(15)
  ratingAvg         Float          @default(0)
  ratingCount       Int            @default(0)
  /// JSON: { mon: { open: "09:00", close: "21:00" }, ... }
  openingHours      Json?
  preferredDelivery DeliveryMethod @default(SELF)

  products       Product[]
  orders         Order[]
  paymentIntents PaymentIntent[]
  coupons        ShopCoupon[]
  ads       Ad[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([latitude, longitude])
  @@index([category])
  @@index([isActive])
}

/// MERCHANT DASHBOARD EXPANSION — store-scoped promotional offers
model ShopCoupon {
  id            String       @id @default(uuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code          String
  discountType  DiscountType
  discountValue Float
  minOrderValue Float        @default(0)
  maxUses       Int          @default(100)
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([shopId, code])
  @@index([shopId, isActive])
}

model Product {
  id          String  @id @default(uuid())
  shopId      String
  shop        Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  /// Original / MRP price (before discount). Null = no discount shown.
  mrp         Float?
  image       String?
  isAvailable Boolean @default(true)
  unit        String  @default("piece")
  stock       Int     @default(10)
  /// Menu grouping for category-scoped storefront feeds (sub-platform tabs)
  category    String  @default("general")

  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([shopId, isAvailable])
  @@index([shopId, category])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  shopId     String
  customerId String
  riderId    String?
  shopRating Int
  riderRating Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([shopId])
}

model Order {
  id                String  @id @default(uuid())
  orderNumber       String  @unique
  customerId        String
  customer          User    @relation("CustomerOrders", fields: [customerId], references: [id])
  shopId            String
  shop              Shop    @relation(fields: [shopId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   User?   @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id])

  status              OrderStatus     @default(PENDING)
  deliveryMethod      DeliveryMethod?
  totalPrice          Float
  deliveryFee         Float
  riderTip            Float           @default(0)
  deliveryAddress     String
  /// Customer delivery address — masked until delivery confirmed
  deliveryAddressEnc  String?
  deliveryInstruction String?
  destLatitude        Float?
  destLongitude       Float?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  paymentStatus      PaymentStatus @default(PENDING)
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?
  appliedCouponCode  String?
  discountAmount     Float         @default(0)
  paymentIntentId    String?       @unique
  paymentIntent      PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  items         OrderItem[]
  statusHistory OrderStatusEvent[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([customerId])
  @@index([shopId, status])
  @@index([deliveryPartnerId, status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@index([orderId])
}

/// Pre-payment checkout snapshot — order is created only after Razorpay confirms payment.
model PaymentIntent {
  id                  String              @id @default(uuid())
  customerId          String
  customer            User                @relation(fields: [customerId], references: [id])
  shopId              String
  shop                Shop                @relation(fields: [shopId], references: [id])
  status              PaymentIntentStatus @default(PENDING)
  razorpayOrderId     String?             @unique
  totalPrice          Float
  deliveryFee         Float
  riderTip            Float               @default(0)
  discountAmount      Float               @default(0)
  appliedCouponCode   String?
  deliveryAddress     String
  deliveryInstruction String?
  destLatitude        Float?
  destLongitude       Float?
  /// [{ productId, quantity, price }]
  itemsJson           Json
  failureReason       String?
  order               Order?
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([customerId, status])
  @@index([status, expiresAt])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  minOrderValue Float        @default(0)
  maxUses       Int          @default(100)
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

model OtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
}

/// Email OTP + magic-link challenge. codeHash backs the 6-digit OTP,
/// token backs the verification link; one row serves both.
model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  token     String   @unique
  role      String?
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Ad {
  id          String      @id @default(uuid())
  /// MERCHANT SIDEBAR & CATALOG REFACTOR — null = platform-wide ad
  shopId      String?
  shop        Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  imageUrl    String
  linkUrl     String?
  placement   AdPlacement
  isActive    Boolean     @default(true)
  startDate   DateTime    @default(now())
  endDate     DateTime?
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([placement, isActive])
  @@index([shopId, isActive])
}
