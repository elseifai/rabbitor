DATABASE_URL="postgresql://rabbit:rabbit@localhost:5434/rabbit?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=4000
NODE_ENV=development

# Generate strong secret: openssl rand -base64 32 (must match apps/web)
JWT_SECRET="rabbit-dev-secret-CHANGE-IN-PRODUCTION"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated frontend origins
# Local:  http://localhost:3000,http://localhost:8081
# Prod:   https://rabitor.elseif.ai
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Google OAuth — same Web client as apps/web (mobile code exchange)
# See docs/GOOGLE_SSO_SETUP.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Razorpay (https://dashboard.razorpay.com) ──────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── MSG91 SMS OTP (https://msg91.com) ─────────────────────────────────────
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# ── Cloudinary (https://cloudinary.com) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Firebase FCM (https://console.firebase.google.com) ────────────────────
FIREBASE_SERVICE_ACCOUNT=""
