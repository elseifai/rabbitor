DATABASE_URL="postgresql://rabbit:rabbit@localhost:5434/rabbit?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=4000
NODE_ENV=development
# Generate strong secret: openssl rand -base64 32
JWT_SECRET="rabbit-dev-secret-CHANGE-IN-PRODUCTION"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000"

# ── Razorpay (https://dashboard.razorpay.com) ──────────────────────────────
# 1. Sign up → enable TEST MODE → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── MSG91 SMS OTP (https://msg91.com) ─────────────────────────────────────
# 1. Sign up → SMS → OTP → Create template:
#    "Your Rabbit OTP is ##OTP##. Valid for 10 mins. -Rabbit"
# 2. Settings → API → copy Auth Key + Template ID
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# ── Cloudinary (https://cloudinary.com) ───────────────────────────────────
# 1. Sign up free (25GB) → Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Firebase FCM (https://console.firebase.google.com) ────────────────────
# 1. Create project → Settings → Service Accounts → Generate private key
# 2. Paste entire JSON as single line string
FIREBASE_SERVICE_ACCOUNT=""
