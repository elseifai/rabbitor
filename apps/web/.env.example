SOCKET_BROADCAST_URL="http://localhost:4000"
API_URL="http://localhost:4000"

# GOOGLE MAPS & AUTH ACTIVATION — Google OAuth (server) + Maps (client)
GOOGLE_CLIENT_ID=""
