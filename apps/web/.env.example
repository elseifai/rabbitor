DATABASE_URL="postgresql://rabbit:rabbit@localhost:5432/rabbit?schema=public"

# ── URLs ──
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:4000"
SOCKET_BROADCAST_URL="http://localhost:4000"
# Production:
# NEXT_PUBLIC_APP_URL="https://rabitor.elseif.ai"
# PUBLIC_APP_URL="https://rabitor.elseif.ai"
# API_URL="https://api.rabitor.elseif.ai"
# NEXT_PUBLIC_API_URL="https://api.rabitor.elseif.ai"
# NEXT_PUBLIC_SOCKET_SERVER_URL="https://api.rabitor.elseif.ai"
# SOCKET_BROADCAST_URL="https://api.rabitor.elseif.ai"

# Google OAuth (server) — see docs/GOOGLE_SSO_SETUP.md
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
COOKIE_SECURE=false

# Google Maps (order tracking)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Razorpay (required for checkout — public key for client modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Server-side Razorpay credentials (same key id + secret from dashboard)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional webhook secret for payment.captured / payment.failed cleanup
RAZORPAY_WEBHOOK_SECRET=""

# Must match apps/api JWT_SECRET
JWT_SECRET="dev-secret-change-in-production"

# Firebase Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
