DATABASE_URL=postgresql://user:password@host:5432/rabbit?schema=public

# Session signing (must match apps/api JWT_SECRET)
JWT_SECRET=
NEXTAUTH_SECRET=

# Backend API (Railway deployment URL)
NEXT_PUBLIC_API_URL=https://your-api.railway.app
API_URL=https://your-api.railway.app

# Realtime tracking
NEXT_PUBLIC_SOCKET_SERVER_URL=https://your-api.railway.app
SOCKET_BROADCAST_URL=https://your-api.railway.app

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Firebase Cloud Messaging (web push)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
