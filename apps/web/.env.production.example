DATABASE_URL=postgresql://user:password@host:5432/rabbit?schema=public

# Session signing (must match apps/api JWT_SECRET)
JWT_SECRET=

# Frontend (OAuth redirect_uri host)
NEXT_PUBLIC_APP_URL=https://rabitor.elseif.ai
PUBLIC_APP_URL=https://rabitor.elseif.ai

# Backend API
NEXT_PUBLIC_API_URL=https://api.rabitor.elseif.ai
API_URL=https://api.rabitor.elseif.ai

# Realtime tracking
NEXT_PUBLIC_SOCKET_SERVER_URL=https://api.rabitor.elseif.ai
SOCKET_BROADCAST_URL=https://api.rabitor.elseif.ai

# Google OAuth — redirect URI: https://rabitor.elseif.ai/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=true
ALLOW_DEV_OTP_BYPASS=false
NEXT_PUBLIC_DEV_SANDBOX=false

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Firebase Cloud Messaging (web push)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
