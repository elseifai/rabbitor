# API base URL
# Local (simulator): http://localhost:4000
# Local (physical device): http://<your-lan-ip>:4000
# Production: https://api.rabitor.elseif.ai
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth — Web client ID for Expo Go dev
# Production standalone builds: use iOS/Android client ID from Google Console
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
