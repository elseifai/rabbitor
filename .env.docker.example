# Copy to .env.docker and adjust for your server/domain:
#   cp .env.docker.example .env.docker
#
# Full Google SSO setup: docs/GOOGLE_SSO_SETUP.md

# ── Public URLs (browser + build-time NEXT_PUBLIC_* vars) ──
# Local:
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Production:
# PUBLIC_APP_URL=https://rabbitor.elseif.ai
# PUBLIC_API_URL=https://api.rabitor.elseif.ai

# ── Postgres ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rabbit
POSTGRES_DB=rabbit

# Used by api, web, and migrate (password must be URL-encoded if it contains / + = etc.)
DATABASE_URL=postgresql://rabbit:rabbit@postgres:5432/rabbit?schema=public

# ── Auth ──
# Generate: openssl rand -base64 32 (must match on web + api)
JWT_SECRET=rabbit-super-secret-jwt-change-me
JWT_EXPIRES_IN=7d
INTERNAL_API_SECRET=change-me-internal-secret
ADDRESS_ENCRYPTION_KEY=

# Google OAuth — Web client from Google Cloud Console
# Redirect URI: ${PUBLIC_APP_URL}/api/auth/google/callback
# Local:   http://localhost:3000/api/auth/google/callback
# Prod:    https://rabbitor.elseif.ai/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP — use Resend OR Gmail SMTP (either is enough)
# Resend: https://resend.com
RESEND_API_KEY=
# Gmail SMTP: use an App Password (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rabbit <your-email@gmail.com>

# Production: keep dev bypass off — use real email/SMS OTP only
ALLOW_DEV_OTP_BYPASS=false
NEXT_PUBLIC_DEV_SANDBOX=false
# true for HTTPS production; false for local HTTP
COOKIE_SECURE=false

# CORS — frontend origin(s) allowed to call the API
# Local:  http://localhost:3000,http://localhost:8081
# Prod:   https://rabitor.elseif.ai
CORS_ORIGINS=http://localhost:3000

# ── Database init ──
# Set false after first deploy to skip re-seeding
RUN_SEED=true

# ── Optional integrations ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# ── Razorpay (required for prepaid checkout) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FIREBASE_SERVICE_ACCOUNT=
