# Copy to .env.docker and adjust for your server/domain:
#   cp .env.docker.example .env.docker

# ── Public URLs (browser + build-time NEXT_PUBLIC_* vars) ──
# Use your real domain when deploying to a VPS:
#   PUBLIC_APP_URL=https://rabbit.example.com
#   PUBLIC_API_URL=https://api.rabbit.example.com
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ── Postgres ──
POSTGRES_USER=rabbit
POSTGRES_PASSWORD=rabbit
POSTGRES_DB=rabbit

# Used by api, web, and migrate (password must be URL-encoded if it contains / + = etc.)
DATABASE_URL=postgresql://rabbit:rabbit@postgres:5432/rabbit?schema=public

# ── Auth ──
JWT_SECRET=rabbit-super-secret-jwt-change-me
JWT_EXPIRES_IN=7d

# Google OAuth (Web → APIs & Services → Credentials)
# Authorized redirect URI: ${PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP (https://resend.com — verify your sending domain for production)
RESEND_API_KEY=
EMAIL_FROM=Rabbit <onboarding@resend.dev>

# DEV ONLY BYPASS — enable sandbox role login on test server builds
ALLOW_DEV_OTP_BYPASS=true
NEXT_PUBLIC_DEV_SANDBOX=true
# Set false for HTTP VPS (required for session cookies to work without HTTPS)
COOKIE_SECURE=false

# CORS — include your public web URL
CORS_ORIGINS=http://localhost:3000

# ── Database init ──
# Set false after first deploy to skip re-seeding
RUN_SEED=true

# ── Optional integrations (leave empty for COD-only) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FIREBASE_SERVICE_ACCOUNT=
