{
  "name": "rabbit",
  "version": "0.1.0",
  "private": true,
  "description": "Rabbit — hyperlocal commerce platform",
  "scripts": {
    "dev": "pnpm web:dev",
    "web:dev": "pnpm --filter @rabbit/web dev",
    "web:dev:clean": "pnpm --filter @rabbit/web exec rm -rf .next && pnpm --filter @rabbit/web dev",
    "web:build": "pnpm --filter @rabbit/web build",
    "dev:api": "pnpm --filter @rabbit/database build && pnpm --filter @rabbit/api dev",
    "dev:all": "pnpm --parallel --filter @rabbit/web --filter @rabbit/api dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @rabbit/database generate",
    "db:migrate": "pnpm --filter @rabbit/database migrate",
    "db:deploy": "pnpm --filter @rabbit/database migrate:deploy",
    "db:push": "pnpm --filter @rabbit/database push",
    "db:studio": "pnpm --filter @rabbit/database studio",
    "db:seed": "pnpm --filter @rabbit/database seed",
    "test": "pnpm -r test",
    "mobile:dev": "pnpm --filter @rabbit/mobile start",
    "mobile-delivery:dev": "pnpm --filter @rabbit/mobile-delivery start",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:build": "docker compose --profile app build",
    "docker:deploy": "docker compose --profile app up -d --build",
    "docker:deploy:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs -f",
    "docker:ps": "docker compose --profile app ps"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.1",
      "@types/react-dom": "^19.0.2"
    }
  }
}
